set(manifest_source "@PROJECT_SOURCE_DIR@/manifest.json")
set(git_executable "@GIT_EXECUTABLE@")
set(configured_revision "@NOOKISLE_BUILD_REVISION@")
set(build_type "@CMAKE_BUILD_TYPE@")
if(DEFINED CMAKE_INSTALL_CONFIG_NAME AND NOT CMAKE_INSTALL_CONFIG_NAME STREQUAL "")
    set(build_type "${CMAKE_INSTALL_CONFIG_NAME}")
endif()

set(build_revision "")
if(DEFINED ENV{NOOKISLE_BUILD_REVISION} AND NOT "$ENV{NOOKISLE_BUILD_REVISION}" STREQUAL "")
    set(build_revision "$ENV{NOOKISLE_BUILD_REVISION}")
elseif(NOT configured_revision STREQUAL "")
    set(build_revision "${configured_revision}")
elseif(EXISTS "${git_executable}" AND EXISTS "@PROJECT_SOURCE_DIR@/.git")
    execute_process(COMMAND "${git_executable}" -C "@PROJECT_SOURCE_DIR@" rev-parse HEAD
        OUTPUT_VARIABLE revision OUTPUT_STRIP_TRAILING_WHITESPACE
        RESULT_VARIABLE git_result ERROR_QUIET)
    if(git_result EQUAL 0 AND NOT revision STREQUAL "")
        set(build_revision "${revision}")
    endif()
endif()

string(LENGTH "${build_revision}" rev_len)
if(build_type STREQUAL "Release")
    if(NOT rev_len EQUAL 40 OR NOT build_revision MATCHES "^[0-9a-fA-F]+$")
        message(FATAL_ERROR "Release mode install requires a 40-character hex revision stamp (got '${build_revision}')")
    endif()
    string(TOLOWER "${build_revision}" build_revision)
elseif(build_revision STREQUAL "")
    set(build_revision "source")
endif()

string(REPLACE "\\" "\\\\" build_revision "${build_revision}")
string(REPLACE "\"" "\\\"" build_revision "${build_revision}")

file(READ "${manifest_source}" manifest)
if(NOT manifest MATCHES "\"build\": \"source\"")
    message(FATAL_ERROR "Source manifest is missing the build marker")
endif()
string(REPLACE "\"build\": \"source\"" "\"build\": \"${build_revision}\"" manifest "${manifest}")
set(destination "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(MAKE_DIRECTORY "${destination}")
file(WRITE "${destination}/manifest.json" "${manifest}")
