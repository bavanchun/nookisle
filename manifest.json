{
  "schemaVersion": 1,
  "id": "io.github.bavanchun.nookisle",
  "name": "Nookisle",
  "version": "1.0.4",
  "build": "source",
  "repository": "https://github.com/bavanchun/nookisle",
  "license": "MIT",
  "author": "bavanchun",
  "description": "Notch-style island for the Omarchy bar: media controls with synced lyrics, a file shelf, calendar, camera mirror and volume/brightness HUD.",
  "kinds": ["bar-widget", "panel", "service"],
  "keepLoaded": true,
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "panel": "Panel.qml",
    "service": "Service.qml"
  },
  "barWidget": {"displayName": "Nookisle", "category": "Media", "allowMultiple": false}
}
