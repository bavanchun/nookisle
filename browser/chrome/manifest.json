{
  "manifest_version": 3,
  "name": "Nookisle",
  "version": "1.0.0",
  "description": "Control the exact Spotify or YouTube document shown by Nookisle.",
  "minimum_chrome_version": "120",
  "permissions": ["nativeMessaging", "alarms"],
  "host_permissions": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://open.spotify.com/*"],
  "background": {"service_worker": "worker.js", "type": "module"},
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*", "https://music.youtube.com/*", "https://open.spotify.com/*"],
    "js": ["adapters.js", "content-script.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
