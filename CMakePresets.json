{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 25, "patch": 0},
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Release with isolated tests",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}
    }
  ],
  "buildPresets": [{"name": "release", "configurePreset": "release", "jobs": 4}],
  "testPresets": [{"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}}]
}
